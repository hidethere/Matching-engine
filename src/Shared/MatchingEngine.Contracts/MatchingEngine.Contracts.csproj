<Project Sdk="Microsoft.NET.Sdk">

  <!-- Shared kernel: wire contracts (messages) + ports. Deliberately zero dependencies
       so it never drags domain/persistence/transport concerns into what every service shares. -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
